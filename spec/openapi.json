roduct is on the stop list.","type":"boolean"},"category":{"description":"The category's name. See List categories.","type":"string"},"description":{"type":"string"},"discountable":{"description":"Whether a discount on the bill reaches this product.","type":"boolean"},"hasModifiers":{"type":"boolean"},"id":{"description":"Stable id.","type":"string"},"image":{"format":"uri","type":["string","null"]},"modifierGroups":{"description":"Only with `expand=modifierGroups`.","items":{"$ref":"#/components/schemas/ModifierGroup"},"type":"array"},"name":{"description":"In the venue's own language.","type":"string"},"popular":{"type":"boolean"},"position":{"description":"Place in the printed menu.","type":"integer"},"prepMinutes":{"type":"integer"},"price":{"description":"In the venue's hall, in AZN.","type":"number"},"spicy":{"type":"boolean"},"station":{"description":"The room it is prepared in. Empty is the kitchen.","type":"string"},"translations":{"additionalProperties":{"properties":{"description":{"type":"string"},"name":{"type":"string"}},"type":"object"},"description":"Only with `expand=translations`. Keyed by language code.","examples":[{"en":{"name":"Plov"},"ru":{"name":"Плов"}}],"type":"object"},"vatRate":{"description":"VAT in percent. Null when the product follows the venue's rate.","type":["number","null"]},"vegetarian":{"type":"boolean"},"video":{"format":"uri","type":["string","null"]}},"required":["id","name","category","price","available"],"type":"object"},"Reservation":{"properties":{"allergyNote":{"type":["string","null"]},"birthday":{"type":"boolean"},"childChair":{"type":"boolean"},"code":{"examples":["MG-7KQ2P"],"type":"string"},"createdAt":{"format":"date-time","type":"string"},"decidedAt":{"format":"date-time","type":["string","null"]},"depositPaid":{"description":"AZN","type":"number"},"endsAt":{"format":"date-time","type":"string"},"externalRef":{"type":["string","null"]},"guest":{"properties":{"email":{"type":["string","null"]},"name":{"type":"string"},"phone":{"type":"string"}},"type":"object"},"guests":{"type":"integer"},"id":{"type":"string"},"preOrder":{"items":{"properties":{"name":{"type":"string"},"note":{"type":["string","null"]},"price":{"type":"number"},"productId":{"type":["string","null"]},"qty":{"type":"integer"}},"type":"object"},"type":"array"},"source":{"enum":["noosh24","open_api"],"type":"string"},"specialRequest":{"type":["string","null"]},"startsAt":{"format":"date-time","type":"string"},"status":{"enum":["pending","confirmed","arriving","checked_in","completed","cancelled","no_show"],"type":"string"},"table":{"properties":{"id":{"type":"string"},"label":{"type":"string"}},"type":["object","null"]},"updatedAt":{"format":"date-time","type":"string"},"zone":{"type":"string"}},"type":"object"},"Review":{"properties":{"author":{"type":"string"},"body":{"type":"string"},"createdAt":{"format":"date-time","type":"string"},"id":{"type":"string"},"overall":{"type":"number"},"ratings":{"properties":{"atmosphere":{"type":"number"},"cleanliness":{"type":"number"},"food":{"type":"number"},"price":{"type":"number"},"service":{"type":"number"}},"type":"object"},"repliedAt":{"format":"date-time","type":["string","null"]},"reply":{"type":["string","null"]},"verified":{"type":"boolean"},"visitType":{"type":"string"},"visitedOn":{"format":"date-time","type":"string"}},"type":"object"},"StockMove":{"properties":{"createdAt":{"format":"date-time","type":"string"},"id":{"type":"string"},"ingredientId":{"type":"string"},"invoiceId":{"type":["string","null"]},"note":{"type":["string","null"]},"orderId":{"type":["string","null"]},"qty":{"description":"Signed: negative leaves the store.","type":"number"},"reason":{"examples":["sale","waste","return","intake"],"type":"string"},"storeId":{"type":["string","null"]}},"type":"object"},"StockStore":{"properties":{"id":{"type":"string"},"isDefault":{"type":"boolean"},"name":{"type":"string"},"stations":{"items":{"type":"string"},"type":"array"}},"type":"object"},"StopListItem":{"properties":{"category":{"type":"string"},"id":{"type":"string"},"name":{"type":"string"},"price":{"type":"number"}},"type":"object"},"Table":{"properties":{"billId":{"type":["string","null"]},"billRequested":{"type":"boolean"},"billSettled":{"type":"boolean"},"billTotal":{"type":["number","null"]},"guests":{"type":["integer","null"]},"hallId":{"type":"string"},"id":{"type":"string"},"label":{"type":"string"},"mergedInto":{"type":["string","null"]},"openOrders":{"type":"integer"},"seatedSince":{"type":["string","null"]},"seats":{"type":"integer"},"shape":{"type":"string"},"status":{"enum":["available","reserved","occupied","cleaning","payment"],"type":"string"},"waiter":{"type":["string","null"]},"zone":{"type":"string"}},"type":"object"},"TableAvailability":{"properties":{"closeTime":{"type":"string"},"durationMinutes":{"type":"integer"},"endsAt":{"format":"date-time","type":"string"},"openTime":{"type":"string"},"startsAt":{"format":"date-time","type":"string"},"tables":{"items":{"properties":{"free":{"type":"boolean"},"hallId":{"type":"string"},"id":{"type":"string"},"label":{"type":"string"},"seats":{"type":"integer"},"zone":{"type":"string"}},"type":"object"},"type":"array"}},"type":"object"},"ZReport":{"additionalProperties":true,"description":"The day's takings by tender and its counts, as the venue's Z-report prints them.","type":"object"}},"securitySchemes":{"apiKey":{"bearerFormat":"nsk_…","description":"The venue's API key.","scheme":"bearer","type":"http"}}},"info":{"contact":{"name":"Noosh24","url":"https://noosh24.com"},"description":"Read a venue's data from Noosh24 in your own system: delivery aggregators, accounting, loyalty, digital signage, BI.\n\n## Authentication\n\nEvery request carries the venue's API key:\n\n```\nAuthorization: Bearer nsk_...\n```\n\n`X-Api-Key: nsk_...` is accepted too. A key belongs to exactly one venue, so there is no venue header: the venue is the one the key was issued for. Keys are issued by Noosh24 on request. The full key is shown once, when it is created; Noosh24 stores only its SHA-256 digest and cannot show it again. A lost key is revoked and replaced.\n\nCall `GET /whoami` to see which venue, scopes and modules a key gives you.\n\n## Scopes and modules\n\nA key carries scopes: `menu:read`, `reservations:read`, `reservations:write`, `orders:read`, `payments:read`, `tables:read`, `customers:read`, `loyalty:read`, `stock:read`, `reviews:read`. An endpoint answers `403 insufficient_scope` when the key lacks the scope it needs.\n\nSome endpoints read data that belongs to a module the venue may not have: loyalty (`loyalty`) and stock (`inventory`). When the venue's subscription does not include that module, the endpoint answers `403 module_not_enabled` with the module name in the message. Menu, reservations, orders, payments, tables, customers and reviews are part of every venue and are never closed this way. `GET /whoami` lists the venue's modules.\n\nWhen the operator suspends a venue, every request with its key answers `403 venue_suspended`.\n\n## Pagination\n\nLists take `limit` (default 20, at most 100; at most 50 when `expand` is used) and `offset` (default 0, at most 10000). The response carries `total`, the number of rows that match the filter. Page 3 with `limit=20` is `offset=40`.\n\n## Sorting\n\n`sort=field asc` or `sort=field desc`, repeatable or comma separated: `sort=category asc\u0026sort=price desc`. Rows with equal values are ordered by `id`, so pages do not overlap.\n\n## Filtering\n\n`where` takes conditions joined by `AND`:\n\n```\nwhere=category = 'Salads' AND price \u003e= 5 AND available = true\nwhere=id in ('7f0c…', '91ab…')\n```\n\nOperators: `=` `!=` `\u003e` `\u003c` `\u003e=` `\u003c=` `in`. Strings are in single quotes (a quote inside a string is written twice: `'Chef''s'`), numbers are bare, booleans are `true` and `false`. Dates are quoted strings: `'2026-11-01'` is midnight in Baku, or give a full timestamp such as `'2026-11-01T18:00:00+04:00'`. Boolean fields take only `=` and `!=`. `OR` and parentheses are not supported. A field that is not filterable answers `400 validation_error`.\n\n## Expanding\n\n`expand=modifierGroups` adds each product's modifier groups, `expand=translations` adds its name and description in every language the venue wrote. Repeatable or comma separated.\n\n## Times\n\nEvery timestamp in a response is UTC, RFC 3339. Money is in AZN as a decimal number.\n\n## Errors\n\nEvery error has the same shape:\n\n```json\n{ \"error\": \"validation_error\", \"message\": \"\\\"nope\\\" is not a filterable field on this resource\" }\n```\n\nBranch on `error`; `message` is for people and may change.\n\n| Status | error | Meaning |\n| --- | --- | --- |\n| 400 | `validation_error` | A query parameter is wrong. |\n| 401 | `no_api_key` | No key was sent. |\n| 401 | `invalid_api_key` | The key is wrong or revoked. |\n| 403 | `insufficient_scope` | The key lacks the scope this endpoint needs. |\n| 403 | `module_not_enabled` | The venue does not have the module this endpoint reads. |\n| 403 | `venue_suspended` | The venue is suspended. |\n| 404 | `not_found` | No such row in this venue. |\n| 409 | `table_taken` | The table is already held for that time. |\n| 429 | `rate_limit_exceeded` | Too many requests. Wait for `Retry-After` seconds. |\n| 503 | `temporarily_unavailable` | Try again. |\n\n## Rate limits\n\n600 requests a minute per key, and 1200 a minute per IP address.","title":"Noosh24 Open API","version":"1.1.0"},"openapi":"3.1.0","paths":{"/bills":{"get":{"description":"Table bills (sittings) with their totals, counted the way the venue's bill counts them. At most 50 per page.\n\nScope: `orders:read`.\n\nFilterable: `id`, `status`, `tableId`, `customerId`, `openedAt`, `closedAt`.\n\nSortable: `id`, `openedAt`, `closedAt`. Default: `openedAt desc`.","operationId":"listBills","parameters":[{"in":"query","name":"limit","schema":{"default":20,"maximum":50,"minimum":1,"type":"integer"}},{"$ref":"#/components/parameters/offset"},{"$ref":"#/components/parameters/sort"},{"$ref":"#/components/parameters/where"}],"responses":{"200":{"content":{"application/json":{"schema":{"properties":{"data":{"properties":{"items":{"items":{"$ref":"#/components/schemas/Bill"},"type":"array"},"limit":{"type":"integer"},"offset":{"type":"integer"},"total":{"type":"integer"}},"required":["items","total"],"type":"object"}},"required":["data"],"type":"object"}}},"description":"List bills"},"400":{"$ref":"#/components/responses/ValidationError"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"429":{"$ref":"#/components/responses/TooManyRequests"}},"summary":"List bills","tags":["Orders"],"x-scope":"orders:read"}},"/bills/{billId}":{"get":{"description":"One bill by id.\n\nScope: `orders:read`.","operationId":"getBill","parameters":[{"in":"path","name":"billId","required":true,"schema":{"type":"string"}}],"responses":{"200":{"content":{"application/json":{"schema":{"properties":{"data":{"$ref":"#/components/schemas/Bill"}},"required":["data"],"type":"object"}}},"description":"Get a bill"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/TooManyRequests"}},"summary":"Get a bill","tags":["Orders"],"x-scope":"orders:read"}},"/customers":{"get":{"description":"The venue's own customer records.\n\nScope: `customers:read`.\n\nFilterable: `id`, `phone`, `createdAt`, `updatedAt`.\n\nSortable: `id`, `name`, `createdAt`, `updatedAt`. Default: `name asc`.","operationId":"listCustomers","parameters":[{"$ref":"#/components/parameters/limit"},{"$ref":"#/components/parameters/offset"},{"$ref":"#/components/parameters/sort"},{"$ref":"#/components/parameters/where"}],"responses":{"200":{"content":{"application/json":{"schema":{"properties":{"data":{"properties":{"items":{"items":{"$ref":"#/components/schemas/Customer"},"type":"array"},"limit":{"type":"integer"},"offset":{"type":"integer"},"total":{"type":"integer"}},"required":["items","total"],"type":"object"}},"required":["data"],"type":"object"}}},"description":"List customers"},"400":{"$ref":"#/components/responses/ValidationError"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"429":{"$ref":"#/components/responses/TooManyRequests"}},"summary":"List customers","tags":["Customers"],"x-scope":"customers:read"}},"/customers/{customerId}":{"get":{"description":"One customer record by id.\n\nScope: `customers:read`.","operationId":"getCustomer","parameters":[{"in":"path","name":"customerId","required":true,"schema":{"type":"string"}}],"responses":{"200":{"content":{"application/json":{"schema":{"properties":{"data":{"$ref":"#/components/schemas/Customer"}},"required":["data"],"type":"object"}}},"description":"Get a customer"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/TooManyRequests"}},"summary":"Get a customer","tags":["Customers"],"x-scope":"customers:read"}},"/halls":{"get":{"description":"The venue's rooms, in its own order.\n\nScope: `tables:read`.","operationId":"listHalls","parameters":[],"responses":{"200":{"content":{"application/json":{"schema":{"properties":{"data":{"properties":{"items":{"items":{"$ref":"#/components/schemas/Hall"},"type":"array"},"total":{"type":"integer"}},"type":"object"}},"required":["data"],"type":"object"}}},"description":"List halls"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"429":{"$ref":"#/components/responses/TooManyRequests"}},"summary":"List halls","tags":["Tables"],"x-scope":"tables:read"}},"/loyalty/cards":{"get":{"description":"Every member's stamp card. Module: `loyalty`.\n\nScope: `loyalty:read`.\n\nFilterable: `