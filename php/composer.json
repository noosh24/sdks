{
    "name": "noosh24/open-api",
    "description": "Official PHP client for the Noosh24 Open API",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "noosh24",
        "restaurant",
        "pos",
        "open-api",
        "sdk",
        "azerbaijan"
    ],
    "homepage": "https://developer.noosh24.com",
    "support": {
        "docs": "https://developer.noosh24.com/reference"
    },
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.5 || ^13.4"
    },
    "autoload": {
        "psr-4": {
            "Noosh24\\OpenApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Noosh24\\OpenApi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
